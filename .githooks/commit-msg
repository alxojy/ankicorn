#!/bin/sh
# Conventional Commits: type(scope): subject
msg=$(head -n1 "$1")
if ! echo "$msg" | grep -Eq '^(feat|fix|test|docs|chore|refactor|perf|build|ci|style|revert)(\([a-z0-9./-]+\))?!?: .{3,}'; then
  echo "commit-msg: use Conventional Commits, e.g. 'feat(dashboard): port KPI tiles' (got: $msg)" >&2
  exit 1
fi
