#!/bin/sh
# Ledger must only grow; specs must pass their checks; code checks when code is staged.
set -e
# Never commit crash dumps or large files.
big=$(git diff --cached --name-only --diff-filter=AM | while read -r f; do
  [ -f "$f" ] || continue
  case "$(basename "$f")" in (core|core.*|*.core) echo "$f (crash dump)"; continue ;; esac
  size=$(wc -c < "$f")
  if [ "$size" -gt 10485760 ]; then echo "$f ($size bytes)"; fi
done)
if [ -n "$big" ]; then
  echo "pre-commit: refusing crash dumps / files over 10 MB:" >&2
  echo "$big" >&2
  exit 1
fi
node tools/check-ledger.mjs
if git diff --cached --name-only | grep -q '^openspec/'; then
  node tools/check-spec.mjs
fi
if git diff --cached --name-only | grep -Eq '^(app/|crates/|Cargo\.(toml|lock)$)'; then
  npm run -s precommit:code
fi
